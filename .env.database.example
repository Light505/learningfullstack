# Database VPS values for raw MySQL installed with apt.
# Copy this file to `.env` on the database VPS.

# Prefer the database VPS private/VPC IP.
# This is the address MySQL should bind to and the web VPS should connect to.
DB_HOST=database_vps_private_ip
DB_PORT=3306
DB_NAME=mydb
DB_USER=app_user
DB_PASS=replace_with_strong_app_password

# Web VPS address allowed to connect to MySQL.
# Prefer the web VPS private/VPC IP. If private networking is unavailable,
# use the web VPS public IP and restrict the database firewall to that IP.
WEB_VPS_MYSQL_HOST=web_vps_private_ip
