# Optional external database values.
# The default production deployment uses Docker MySQL on the same VPS through
# docker-compose.database.yml. Use these DB_* values only when MySQL runs
# outside the Compose stack.
#
# Prefer the database VPS private/VPC IP. If private networking is unavailable,
# use the public IP only with firewall rules that allow 3306 from the web VPS IP
# and deny everyone else.
DB_HOST=10.0.0.5
DB_PORT=3306
DB_NAME=mydb
DB_USER=app_user
DB_PASS=replace_with_strong_app_password
