# Application
APP_DEBUG=false
APP_DOMAIN=example.com

# Web image
# Local development can use: learningfullstack-web:local
# Production should use: ghcr.io/light505/learningfullstack:prod
# Testing can use: ghcr.io/light505/learningfullstack:test
WEB_IMAGE=ghcr.io/light505/learningfullstack:prod

# MySQL
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
MYSQL_DATABASE=mydb
MYSQL_USER=app_user
MYSQL_PASSWORD=replace_with_strong_app_password

# Traefik / Let's Encrypt
TRAEFIK_ACME_EMAIL=admin@example.com

# GitHub Container Registry
# Used by Watchtower on the VPS to pull private GHCR images.
# For local image pushing, your local shell can also load these values.
GHCR_USERNAME=Light505
GHCR_TOKEN=replace_with_github_token

# Watchtower
# 300 seconds = check every 5 minutes.
WATCHTOWER_POLL_INTERVAL=300
