# Local development only.
# Copy this file to `.env` on your Windows machine.
APP_DEBUG=true
APP_DOMAIN=localhost

# Local Compose uses docker-compose.override.yml to build this image.
# Keep this local value. It is not the GHCR production image.
WEB_IMAGE=learningfullstack-web:local

# Local MySQL container values.
# Use your own local-only passwords. These do not need to match production.
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
MYSQL_DATABASE=appdb
MYSQL_USER=appuser
MYSQL_PASSWORD=replace_with_local_app_password

# App database connection used by the PHP container.
# For local Compose, DB_HOST stays `db`.
DB_HOST=db
DB_PORT=3306
DB_NAME=appdb
DB_USER=appuser
DB_PASS=replace_with_local_app_password
