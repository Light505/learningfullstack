# Local development
APP_DEBUG=true
APP_DOMAIN=localhost

# Local Compose uses docker-compose.override.yml to build this image.
WEB_IMAGE=learningfullstack-web:local

# Database connection used by the app.
# Local Compose points this at the local MySQL container.
DB_HOST=db
DB_PORT=3306
DB_NAME=appdb
DB_USER=appuser
DB_PASS=Str0ng!Pass#2026

# MySQL root password for the local database container.
MYSQL_ROOT_PASSWORD=Str0ng!Pass#2026
