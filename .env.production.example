# Production deployment template.
# Copy this to /opt/learningfullstack/.env on the VPS and replace every
# placeholder before running a deployment script.
#
# Do not store GitHub tokens here. Use GHCR_TOKEN in the shell or enter the
# token when prompted by the deployment script.

# App image and public domain.
WEB_IMAGE=ghcr.io/light505/learningfullstack:prod
APP_DOMAIN=example.com
APP_DEBUG=false

# Traefik / Let's Encrypt.
# DNS for APP_DOMAIN must point to the web VPS before Traefik can issue certs.
TRAEFIK_ACME_EMAIL=admin@example.com

# Watchtower.
# 300 seconds = check every 5 minutes.
WATCHTOWER_POLL_INTERVAL=300

# Optional GHCR username for private image pulls.
# The token must have package read access. Private repo-linked packages may
# require a classic PAT with read:packages and repo scopes.
GHCR_USERNAME=Light505

# Single-server database mode.
# Used by scripts/deploy-single-server.sh with docker-compose.database.yml.
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
MYSQL_DATABASE=mydb
MYSQL_USER=app_user
MYSQL_PASSWORD=replace_with_strong_app_password

# External database mode.
# Used by scripts/deploy-external-web.sh and scripts/provision-external-db.sh.
# Prefer a private/VPC database IP when available.
DB_HOST=replace_with_database_host
DB_PORT=3306
DB_NAME=mydb
DB_USER=app_user
DB_PASS=replace_with_strong_app_password

# External DB provisioning only.
# Set this on the DB server to the web VPS private/VPC IP or exact public IP.
WEB_SERVER_DB_ALLOWED_HOST=replace_with_web_vps_ip

# External DB provisioning only.
# 0.0.0.0 allows MySQL to listen on the network; restrict access with UFW or
# your cloud firewall to WEB_SERVER_DB_ALLOWED_HOST only.
MYSQL_BIND_ADDRESS=0.0.0.0
