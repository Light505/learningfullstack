# Web VPS runtime.
# Copy this file to `.env` on the web VPS if you are not using
# .env.production.example.
APP_DEBUG=false
APP_DOMAIN=your-domain.com

# Traefik / Let's Encrypt.
TRAEFIK_ACME_EMAIL=admin@your-domain.com

# GHCR image watched by Watchtower.
# Use `:prod` for production unless you are intentionally testing another tag.
WEB_IMAGE=ghcr.io/light505/learningfullstack:prod

# Default single-server Docker MySQL values.
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
MYSQL_DATABASE=mydb
MYSQL_USER=app_user
MYSQL_PASSWORD=replace_with_strong_app_password

# Optional external MySQL mode:
# use DB_HOST, DB_PORT, DB_NAME, DB_USER, and DB_PASS instead, then run only
# docker-compose.web.yml without docker-compose.database.yml.
# Prefer the database VPS private/VPC IP. If you must use a public IP, the
# database firewall must allow 3306 only from the web VPS IP.
# DB_HOST=database_vps_private_ip
# DB_PORT=3306
# DB_NAME=mydb
# DB_USER=app_user
# DB_PASS=replace_with_strong_app_password

# Watchtower.
# 300 seconds = check every 5 minutes.
WATCHTOWER_POLL_INTERVAL=300
