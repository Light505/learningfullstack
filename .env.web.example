# Web VPS runtime
APP_DEBUG=false
APP_DOMAIN=example.com

# Public GHCR image watched by Watchtower
WEB_IMAGE=ghcr.io/light505/learningfullstack:prod

# Default single-server Docker MySQL values.
MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
MYSQL_DATABASE=mydb
MYSQL_USER=app_user
MYSQL_PASSWORD=replace_with_strong_app_password

# Optional external MySQL mode:
# use DB_HOST, DB_PORT, DB_NAME, DB_USER, and DB_PASS instead, then run only
# docker-compose.web.yml without docker-compose.database.yml.

# Traefik / Let's Encrypt
TRAEFIK_ACME_EMAIL=admin@example.com

# Watchtower
# 300 seconds = check every 5 minutes.
WATCHTOWER_POLL_INTERVAL=300
