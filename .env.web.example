# Web VPS runtime.
# Copy this file to `.env` on the web VPS.
APP_DEBUG=false
APP_DOMAIN=your-domain.com

# Public hostname certificate email for Traefik / Let's Encrypt.
TRAEFIK_ACME_EMAIL=admin@your-domain.com

# GHCR image watched by Watchtower.
# Use `:prod` for production unless you are intentionally testing another tag.
WEB_IMAGE=ghcr.io/light505/learningfullstack:prod

# External MySQL database VPS.
# Prefer the database VPS private/VPC IP.
# If you must use a public IP, the database VPS firewall must allow 3306 only
# from the web VPS IP.
DB_HOST=database_vps_private_ip
DB_PORT=3306
DB_NAME=mydb
DB_USER=app_user
DB_PASS=replace_with_strong_app_password

# Watchtower.
# 300 seconds = check every 5 minutes.
WATCHTOWER_POLL_INTERVAL=300
