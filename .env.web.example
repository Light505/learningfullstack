# Web VPS runtime
APP_DEBUG=false
APP_DOMAIN=example.com

# Public GHCR image watched by Watchtower
WEB_IMAGE=ghcr.io/light505/learningfullstack:prod

# External MySQL database VPS.
# Prefer a private/VPC IP. If unavailable, use the database VPS public IP only
# when the database firewall allows 3306 from the web VPS IP and denies others.
DB_HOST=10.0.0.5
DB_PORT=3306
DB_NAME=mydb
DB_USER=app_user
DB_PASS=replace_with_strong_app_password

# Traefik / Let's Encrypt
TRAEFIK_ACME_EMAIL=admin@example.com

# Watchtower
# 300 seconds = check every 5 minutes.
WATCHTOWER_POLL_INTERVAL=300
